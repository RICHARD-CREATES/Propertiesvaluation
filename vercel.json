{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "buildCommand": "cd frontend && npm install && npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,datasets/**,deteail/**,presentation/**,docs/**,reports/**,images/**,frontend/node_modules/**,frontend/src/**}"
    }
  }
}
