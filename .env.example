# Runtime Server Configuration
PORT=8000
RATE_LIMIT_ENABLED=1
RATE_LIMIT_RPM=180

# Database URL (SQLite default; PostgreSQL supported via connection string)
RENTAL_DATABASE_URL=sqlite:///data/rental_intelligence.db

# Cryptographic Signing Secret for Server-Side Verification & Ingestion Tokens
# Generate in production via: python -c "import secrets; print(secrets.token_hex(32))"
VERIFICATION_HMAC_SECRET=

# Optional JSON map overriding demo staff accounts with production scrypt hashes
# Example: {"verifier_prod":{"role":"AUTHORIZED_REGISTRY_VERIFIER","salt_hex":"...","password_hash":"..."}}
ADMIN_USERS_JSON=

# Optional overrides for local hackathon demo accounts (never expose defaults in production!)
DEMO_REVIEWER_PASS=ReviewBbsr#2026
DEMO_VERIFIER_PASS=VerifyIgr#2026
DEMO_ADMIN_PASS=AuditAdmin#2026
